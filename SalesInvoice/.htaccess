# Apache settings (needs AllowOverride All, the XAMPP default).
# Other servers like Nginx ignore this file.

# No directory listings
Options -Indexes

# Block hidden files like .env
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Block files that are only meant to be included
<FilesMatch "^(db_config|bootstrap)\.php$">
    Require all denied
</FilesMatch>

# Block SQL files, logs and backups
<FilesMatch "\.(sql|log|bak|old|swp)$">
    Require all denied
</FilesMatch>

# Safer session cookies (when PHP runs as an Apache module, like in XAMPP)
<IfModule php_module>
    php_flag  session.cookie_httponly On
    php_flag  session.use_strict_mode On
    php_value session.cookie_samesite Lax
</IfModule>

# Basic security headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
</IfModule>
